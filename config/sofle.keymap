#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        Prodrafts_Lasso_backspace: Prodrafts_Lasso_backspace {
            compatible = "zmk,behavior-tap-dance";
            label = "PRODRAFTS_LASSO_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp BACKSPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6
                &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y
                &kp A   &kp S   &kp D   &kp F   &kp G   &kp H
                &kp Z   &kp X   &kp C   &kp V   &kp B   &kp N

                &kp G   &kp A   &to 1   &kp D   &trans
            >;
        };

        layer_1 {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
                &to 2          &to 3          &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans
                &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT   &trans         &trans         &trans

                &bt BT_PRV  &bt BT_NXT  &to 0  &trans  &trans
            >;
        };

        Prodrafts {
            bindings = <
                &Prodrafts_Lasso_backspace  &kp E          &trans         &trans         &trans  &trans
                &kp LG(Z)                   &kp LG(LS(Z))  &trans         &trans         &trans  &trans
                &kp N5                      &kp NUMBER_6   &kp N7         &trans         &trans  &trans
                &kp NUMBER_2                &kp NUMBER_3   &kp NUMBER_4  &trans         &trans  &trans

                &kp NUMBER_1  &kp LG(TAB)  &to 1  &trans  &trans
            >;
        };

        Noteful {
            bindings = <
                &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3   &kp NUMBER_4     &kp N5          &kp NUMBER_6
                &kp F          &kp E          &kp H          &kp LG(N0)       &kp LG(EQUAL)   &trans
                &kp G          &kp A          &kp BACKSPACE  &kp LG(LS(N0))   &kp LG(MINUS)   &trans
                &kp LG(Z)      &kp LG(LS(Z))  &kp LG(TAB)    &kp LC(TAB)      &trans          &trans

                &kp LEFT  &kp RIGHT  &to 1  &kp LG(TAB)  &trans
            >;
        };
    };
};
